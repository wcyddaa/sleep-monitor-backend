# ====== 应用配置 ======
APP_NAME=sleep-monitor-backend
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# ====== 安全配置 ======
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ====== 数据库 ======
# 默认使用本地 SQLite，开箱即用；生产可换 MySQL/PostgreSQL
DATABASE_URL=sqlite+aiosqlite:///./data/sleep_monitor.db

# ====== LLM 配置（可选，不填则使用本地 Mock LLM）======
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# ====== 数据接入方式 INGEST_MODE（simulator | http | amqp | mqtt）======
INGEST_MODE=simulator

# --- HTTP webhook（华为云规则引擎 HTTPS 转发）---
# HTTP_WEBHOOK_TOKEN=your-shared-token

# --- AMQP 推送（华为云 IoTDA AMQP 队列）---
# AMQP_HOST=xxx.iot-amqp.cn-north-4.myhuaweicloud.com
# AMQP_PORT=5671
# AMQP_USERNAME=your-access-key
# AMQP_PASSWORD=your-secret
# AMQP_QUEUE=sleep-monitor-queue

# --- 直接 MQTT 订阅 ---
# MQTT_BROKER=127.0.0.1
# MQTT_PORT=1883
# MQTT_USERNAME=
# MQTT_PASSWORD=
# MQTT_TOPIC=$oc/devices/+/sys/messages/up

# --- 模拟器（INGEST_MODE=simulator 时生效）的数据生成参数 ---
SIMULATOR_INTERVAL_SECONDS=30
SIMULATOR_SLEEP_HOURS_MIN=6
SIMULATOR_SLEEP_HOURS_MAX=8
SIMULATOR_SAMPLE_INTERVAL_MINUTES=5
SIMULATOR_HEART_RATE_MEAN=65.0
SIMULATOR_HEART_RATE_STD=6.0
SIMULATOR_RESP_RATE_MEAN=15.0
SIMULATOR_RESP_RATE_STD=2.0
SIMULATOR_SNORE_SEGMENTS_MAX=4
